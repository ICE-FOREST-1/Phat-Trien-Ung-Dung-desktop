<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NganHang.App.Views.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:NganHang.Core.Entities"
    xmlns:h="using:NganHang.App.Helpers"
    Background="Transparent">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Tra cứu khách hàng 360°" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Hồ sơ định danh CIF, tài khoản thanh toán, sổ tiết kiệm và hợp đồng tín dụng" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.CoThongBao, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.MucDoThongBao, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ThongBao, Mode=OneWay}" />

        <!-- Khung nội dung: 2 cột (Danh sách bên trái 380px, Chi tiết 360° bên phải) -->
        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: Tìm kiếm + Danh sách -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Ô tìm kiếm -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Tìm kiếm khách hàng" Style="{StaticResource LabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox PlaceholderText="Tìm tên, CIF, CCCD, SĐT…"
                                     Text="{x:Bind ViewModel.TuKhoa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="SearchBox_KeyDown" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.TimKiemCommand}" ToolTipService.ToolTip="Tìm kiếm">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DanhSach, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.KhachHangChon, Mode=OneWay}"
                              SelectionChanged="ListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:KhachHang">
                                <Grid ColumnSpacing="12" Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture Width="36" Height="36" Initials="{x:Bind h:Fmt.ChuCaiDau(HoTenKhachHang)}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind HoTenKhachHang}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind MaCIF}" Style="{StaticResource LabelStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" Background="{x:Bind h:Fmt.MauHang(HangHoiVien)}">
                                        <TextBlock Text="{x:Bind h:Fmt.Ma(HangHoiVien)}" Foreground="White" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- CỘT PHẢI: Hồ sơ chi tiết HOẶC Form thêm/sửa -->
            <Grid Grid.Column="1">
                <!-- 1. Form thêm / sửa khách hàng -->
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.DangChinhSua, Mode=OneWay}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="Thông tin hồ sơ khách hàng" Style="{StaticResource SectionTitleStyle}" />

                            <TextBox Header="Họ và tên khách hàng *"
                                     Text="{x:Bind ViewModel.FormHoTen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Số CCCD (12 chữ số) *"
                                         Text="{x:Bind ViewModel.FormCccd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1" Header="Số điện thoại (10 chữ số) *"
                                         Text="{x:Bind ViewModel.FormSdt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DatePicker Header="Ngày sinh *" Date="{x:Bind ViewModel.FormNgaySinh, Mode=TwoWay}" />
                                <ComboBox Grid.Column="1" Header="Giới tính" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.DanhSachGioiTinh}"
                                          SelectedItem="{x:Bind ViewModel.FormGioiTinh, Mode=TwoWay}" />
                                <NumberBox Grid.Column="2" Header="Điểm tín dụng (300-850)"
                                           Value="{x:Bind ViewModel.FormDiemTinDung, Mode=TwoWay}"
                                           Minimum="300" Maximum="850" SpinButtonPlacementMode="Inline" />
                            </Grid>

                            <TextBox Header="Email" Text="{x:Bind ViewModel.FormEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Header="Địa chỉ thường trú *"
                                     Text="{x:Bind ViewModel.FormDiaChi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Nghề nghiệp" Text="{x:Bind ViewModel.FormNgheNghiep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <NumberBox Grid.Column="1" Header="Thu nhập hàng tháng (VND)"
                                           Value="{x:Bind ViewModel.FormThuNhap, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Hidden" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                                <Button Content="Lưu thông tin" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.LuuKhachHangCommand}" />
                                <Button Content="Hủy bỏ" Command="{x:Bind ViewModel.HuyChinhSuaCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 2. Xem chi tiết 360° -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{x:Bind h:Fmt.An(ViewModel.DangChinhSua), Mode=OneWay}">
                    <StackPanel Spacing="16" Visibility="{x:Bind h:Fmt.HienNeuCo(ViewModel.KhachHangChon), Mode=OneWay}">
                        <!-- Thẻ thông tin khách hàng cơ bản -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <PersonPicture Width="64" Height="64" Initials="{x:Bind h:Fmt.ChuCaiDau(ViewModel.KhachHangChon.HoTenKhachHang), Mode=OneWay}" />

                                <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="6" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{x:Bind ViewModel.KhachHangChon.HoTenKhachHang, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <Border Style="{StaticResource BadgeBorderStyle}" Background="{x:Bind h:Fmt.MauHang(ViewModel.KhachHangChon.HangHoiVien), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind h:Fmt.Ma(ViewModel.KhachHangChon.HangHoiVien), Mode=OneWay}" Foreground="White" Style="{StaticResource BadgeTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.KhachHangChon.MaCIF, Mode=OneWay}" Style="{StaticResource LabelStyle}" />
                                </StackPanel>

                                <Button Grid.Column="2" VerticalAlignment="Top"
                                        Visibility="{x:Bind ViewModel.DuocPhepThemSua}"
                                        Command="{x:Bind ViewModel.BatDauSuaCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        <TextBlock Text="Chỉnh sửa" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Lưới chi tiết CCCD, SĐT, Địa chỉ, Điểm tín dụng -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="20" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Số CCCD" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.KhachHangChon.SoCCCD, Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Số điện thoại" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.KhachHangChon.SoDienThoai, Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Email" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind h:Fmt.Chu(ViewModel.KhachHangChon.Email), Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="2">
                                    <TextBlock Text="Điểm tín dụng" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind h:Fmt.So(ViewModel.KhachHangChon.DiemTinDung), Mode=OneWay}" Style="{StaticResource ValueStyle}" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Thu nhập hàng tháng" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind h:Fmt.TienN(ViewModel.KhachHangChon.ThuNhapHangThang), Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Địa chỉ" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.KhachHangChon.DiaChiThuongTru, Mode=OneWay}" Style="{StaticResource ValueStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Danh sách tài khoản thanh toán -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Tài khoản thanh toán" Style="{StaticResource SectionTitleStyle}" />
                                <ListView ItemsSource="{x:Bind ViewModel.KhachHangChon.TaiKhoans, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="m:TaiKhoanThanhToan">
                                            <Grid ColumnSpacing="16" Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind SoTaiKhoan}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind h:Fmt.Tien(SoDuHienTai)}" FontWeight="Bold" Foreground="{ThemeResource BrandBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind h:Fmt.Ma(TrangThaiTaiKhoan)}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind h:Fmt.NgayN(NgayMoTaiKhoan)}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Danh sách sổ tiết kiệm -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Sổ tiết kiệm" Style="{StaticResource SectionTitleStyle}" />
                                <ListView ItemsSource="{x:Bind ViewModel.KhachHangChon.SoTietKiems, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="m:SoTietKiem">
                                            <Grid ColumnSpacing="16" Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind MaSoSo}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind h:Fmt.Tien(SoTienHienTai)}" FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind h:Fmt.PhanTram(LaiSuatNam)}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind KyHanThang}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind h:Fmt.Ma(TrangThaiSo)}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Danh sách hợp đồng vay -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Hợp đồng tín dụng &amp; Cho vay" Style="{StaticResource SectionTitleStyle}" />
                                <ListView ItemsSource="{x:Bind ViewModel.KhachHangChon.KhoanVays, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="m:KhoanVay">
                                            <Grid ColumnSpacing="16" Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind MaSoHopDongVay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind h:Fmt.Tien(DuNoGocHienTai)}" FontWeight="Bold" Foreground="{ThemeResource WarningBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind h:Fmt.Ma(GoiVay)}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind h:Fmt.Ma(TrangThaiKhoanVay)}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
