<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NganHang.App.Views.SavingsPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:NganHang.Core.Entities"
    xmlns:h="using:NganHang.App.Helpers"
    Background="Transparent">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Quản lý tiết kiệm" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Mở sổ tiết kiệm trực tuyến hoặc nộp tiền mặt tại quầy, tự động tính lãi theo kỳ hạn" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.DuocPhepMoSo}"
                    Command="{x:Bind ViewModel.BatDauMoSoCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Mở sổ tiết kiệm mới" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.CoThongBao, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.MucDoThongBao, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ThongBao, Mode=OneWay}" />

        <!-- Nội dung: Form mở sổ HOẶC Bảng danh sách -->
        <Grid Grid.Row="2">
            <!-- 1. Form mở sổ mới -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.DangMoSo, Mode=OneWay}" MaxWidth="620" HorizontalAlignment="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Mở sổ tiết kiệm mới" Style="{StaticResource SectionTitleStyle}" />

                        <!-- Nguồn gửi: Trích STK vs Nộp tiền mặt -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Phương thức nộp tiền gửi *" Style="{StaticResource LabelStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <RadioButton Content="Trích từ tài khoản thanh toán" IsChecked="{x:Bind ViewModel.TrichTaiKhoan, Mode=TwoWay}" />
                                <RadioButton Content="Nộp tiền mặt tại quầy (Không cần STK)" IsChecked="{x:Bind ViewModel.GuiTienMat, Mode=TwoWay}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Khối A: Trích từ tài khoản thanh toán -->
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.TrichTaiKhoan, Mode=OneWay}">
                            <ComboBox Header="Tài khoản trích tiền *" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.DanhSachTaiKhoan, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.TaiKhoanNguonChon, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:TaiKhoanThanhToan">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind SoTaiKhoan}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind KhachHang.HoTenKhachHang}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind h:Fmt.Tien(SoDuHienTai)}" FontWeight="Bold" Foreground="{ThemeResource BrandBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Khối B: Nộp tiền mặt tại quầy (Không cần STK) -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.GuiTienMat, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <RadioButton Content="Khách hàng đã có CIF" IsChecked="{x:Bind ViewModel.LaKhachHangHienHuu, Mode=TwoWay}" />
                                <RadioButton Content="Khách hàng mới" IsChecked="{x:Bind ViewModel.LaKhachHangMoi, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Khách hàng hiện hữu -->
                            <ComboBox Header="Chọn khách hàng gửi tiền *" HorizontalAlignment="Stretch"
                                      Visibility="{x:Bind ViewModel.LaKhachHangHienHuu, Mode=OneWay}"
                                      ItemsSource="{x:Bind ViewModel.DanhSachKhachHang, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.KhachHangChon, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:KhachHang">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind HoTenKhachHang}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind MaCIF}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Khách hàng mới toanh -->
                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.LaKhachHangMoi, Mode=OneWay}">
                                <TextBox Header="Họ và tên người gửi tiền *" PlaceholderText="vd: Trần Văn Bình"
                                         Text="{x:Bind ViewModel.FormHoTen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Header="Số CCCD (12 chữ số) *" PlaceholderText="vd: 079201009999" MaxLength="12"
                                             Text="{x:Bind ViewModel.FormCccd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1" Header="Số điện thoại (10 chữ số) *" PlaceholderText="vd: 0912345678" MaxLength="10"
                                             Text="{x:Bind ViewModel.FormSdt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <TextBox Header="Địa chỉ thường trú *" PlaceholderText="vd: 45 Lê Lợi, Quận 1, TP.HCM"
                                         Text="{x:Bind ViewModel.FormDiaChi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Ô mã số sổ tiết kiệm: Tự nhập hoặc random -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Mã số sổ tiết kiệm (Mã định danh sổ) *" Style="{StaticResource LabelStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" PlaceholderText="vd: STK-2026-1001 hoặc nhập mã số sổ..." MaxLength="20"
                                         Text="{x:Bind ViewModel.FormMaSoSo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="🎲 Tạo ngẫu nhiên"
                                        Command="{x:Bind ViewModel.TaoMaSoNgauNhienCommand}" />
                            </Grid>
                        </StackPanel>

                        <NumberBox Header="Số tiền gửi (tối thiểu 1.000.000 VND) *"
                                   Value="{x:Bind ViewModel.SoTienGui, Mode=TwoWay}"
                                   Minimum="1000000" SpinButtonPlacementMode="Hidden" />

                        <!-- Chọn kỳ hạn -->
                        <ComboBox Header="Kỳ hạn gửi *" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.DanhSachKyHan}"
                                  SelectedItem="{x:Bind ViewModel.KyHanThang, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="x:Int32">
                                    <TextBlock Text="{x:Bind}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Thẻ lãi suất & lãi dự kiến -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,12" CornerRadius="8">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Lãi suất áp dụng" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind h:Fmt.PhanTram(ViewModel.LaiSuatApDung), Mode=OneWay}" Style="{StaticResource ValueStyle}" Foreground="{ThemeResource BrandBrush}" FontSize="18" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Tiền lãi dự kiến" Style="{StaticResource LabelStyle}" />
                                    <TextBlock Text="{x:Bind h:Fmt.Tien(ViewModel.TienLaiDuKien), Mode=OneWay}" Style="{StaticResource ValueStyle}" Foreground="{ThemeResource SuccessBrush}" FontSize="18" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                            <Button Content="Xác nhận mở sổ" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.XacNhanMoSoCommand}" />
                            <Button Content="Hủy bỏ" Command="{x:Bind ViewModel.HuyMoSoCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 2. Danh sách sổ tiết kiệm (có thanh cuộn ngang) -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Fmt.An(ViewModel.DangMoSo), Mode=OneWay}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel MinWidth="1200" Spacing="12">
                        <Border Style="{StaticResource TableHeaderBorderStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mã số sổ" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="Khách hàng" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="Nguồn tiền" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="Số tiền gửi" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="Kỳ hạn" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="5" Text="Lãi suất" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="6" Text="Ngày gửi" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="7" Text="Ngày đáo hạn" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="8" Text="Trạng thái" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="9" Text="Thao tác" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <ListView ItemsSource="{x:Bind ViewModel.DanhSach, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource TableListViewItemStyle}" />
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:SoTietKiem">
                                    <Grid ColumnSpacing="12" Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind MaSoSo}" Style="{StaticResource TableCellStyle}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind KhachHang.HoTenKhachHang}" Style="{StaticResource TableCellStyle}" />
                                        <!-- Cột nguồn tiền: STK hoặc Tiền mặt -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind TaiKhoanNguon.SoTaiKhoan}" Style="{StaticResource TableCellStyle}" Visibility="{x:Bind h:Fmt.HienNeuCo(TaiKhoanNguon.SoTaiKhoan)}" />
                                        <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind h:Fmt.AnNeuCo(TaiKhoanNguon.SoTaiKhoan)}" Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left">
                                            <TextBlock Text="Tiền mặt tại quầy" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{x:Bind h:Fmt.Tien(SoTienHienTai)}" Style="{StaticResource TableCellStyle}" FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind KyHanThang}" Style="{StaticResource TableCellStyle}" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind h:Fmt.PhanTram(LaiSuatNam)}" Style="{StaticResource TableCellStyle}" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind h:Fmt.Ngay(NgayGui)}" Style="{StaticResource TableCellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="7" Text="{x:Bind h:Fmt.Ngay(NgayDaoHan)}" Style="{StaticResource TableCellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Border Grid.Column="8" Style="{StaticResource BadgeBorderStyle}">
                                            <TextBlock Text="{x:Bind h:Fmt.Ma(TrangThaiSo)}" Style="{StaticResource BadgeTextStyle}" Foreground="{x:Bind h:Fmt.MauTrangThai(TrangThaiSo)}" />
                                        </Border>
                                        <Button Grid.Column="9" HorizontalAlignment="Right"
                                                Visibility="{x:Bind h:Fmt.HienNeuBang(TrangThaiSo, 'DANG_HOAT_DONG')}"
                                                Command="{Binding ElementName=ThisPage, Path=ViewModel.TatToanCommand}"
                                                CommandParameter="{x:Bind}">
                                            <TextBlock Text="Tất toán" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
