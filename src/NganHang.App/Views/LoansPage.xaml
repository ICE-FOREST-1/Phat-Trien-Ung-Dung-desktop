<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NganHang.App.Views.LoansPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:NganHang.Core.Policies"
    xmlns:m="using:NganHang.Core.Entities"
    xmlns:h="using:NganHang.App.Helpers"
    Background="Transparent">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Quản lý tín dụng &amp; Cho vay" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Thẩm định hồ sơ, phê duyệt hạn mức và giải ngân trực tiếp vào tài khoản thanh toán" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.DuocPhepLapHoSo}"
                    Command="{x:Bind ViewModel.BatDauLapHoSoCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Lập hồ sơ vay mới" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.CoThongBao, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.MucDoThongBao, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ThongBao, Mode=OneWay}" />

        <!-- Khung nội dung -->
        <Grid Grid.Row="2">
            <!-- 1. Form lập hồ sơ vay mới -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.DangLapHoSo, Mode=OneWay}" MaxWidth="620" HorizontalAlignment="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Lập hồ sơ vay vốn tín dụng" Style="{StaticResource SectionTitleStyle}" />

                        <!-- Tài khoản giải ngân -->
                        <ComboBox Header="Tài khoản giải ngân *" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.DanhSachTaiKhoan, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.TaiKhoanGiaiNganChon, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:TaiKhoanThanhToan">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind SoTaiKhoan}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind KhachHang.HoTenKhachHang}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="Gói vay vốn *" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.DanhSachGoiVay}"
                                      SelectedItem="{x:Bind ViewModel.GoiVayChon, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind h:Fmt.Ma((x:String))}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <NumberBox Grid.Column="1" Header="Thời hạn vay (tháng) *"
                                       Value="{x:Bind ViewModel.ThoiHanThang, Mode=TwoWay}"
                                       Minimum="1" Maximum="360" SpinButtonPlacementMode="Inline" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox Header="Số tiền vay (VND) *"
                                       Value="{x:Bind ViewModel.SoTienVay, Mode=TwoWay}"
                                       Minimum="10000000" SpinButtonPlacementMode="Hidden" />
                            <NumberBox Grid.Column="1" Header="Lãi suất vay (%/năm)"
                                       Value="{x:Bind ViewModel.LaiSuatVayNam, Mode=TwoWay}"
                                       SpinButtonPlacementMode="Hidden" IsEnabled="False" />
                        </Grid>

                        <TextBox Header="Mục đích sử dụng vốn *"
                                 Text="{x:Bind ViewModel.MucDich, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Tài sản thế chấp nếu không phải vay tín chấp -->
                        <ComboBox Header="Tài sản đảm bảo (nếu có)" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.DanhSachTaiSan, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.TaiSanChon, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="m:TaiSanDamBao">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind TenTaiSan}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind h:Fmt.Tien(GiaTriDinhGia)}" Foreground="{ThemeResource BrandBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Thẻ tạm tính tiền trả góp -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Số tiền trả góp hàng tháng dự kiến (Gốc + Lãi)" Style="{StaticResource LabelStyle}" />
                                <TextBlock Text="{x:Bind h:Fmt.Tien(ViewModel.TraGopHangThangDuKien), Mode=OneWay}" Style="{StaticResource ValueStyle}" Foreground="{ThemeResource BrandBrush}" FontSize="20" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                            <Button Content="Xác nhận lập hồ sơ" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.XacNhanLapHoSoCommand}" />
                            <Button Content="Hủy bỏ" Command="{x:Bind ViewModel.HuyLapHoSoCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 2. Bảng lịch trả nợ chi tiết -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.DangXemLich, Mode=OneWay}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.KhoanVayChon.MaSoHopDongVay, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.KhoanVayChon.KhachHang.HoTenKhachHang, Mode=OneWay}" Style="{StaticResource LabelStyle}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="Đóng lịch" Command="{x:Bind ViewModel.DongLichTraNoCommand}" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource TableHeaderBorderStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Kỳ" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="Ngày trả" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="Tiền gốc" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="Tiền lãi" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="Tổng trả kỳ này" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="Dư nợ còn lại" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.LichTraNo, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource TableListViewItemStyle}" />
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="p:KyTraNo">
                                <Grid ColumnSpacing="12" Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Ky}" Style="{StaticResource TableCellStyle}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind h:Fmt.Ngay(NgayTra)}" Style="{StaticResource TableCellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind h:Fmt.Tien(TienGoc)}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind h:Fmt.Tien(TienLai)}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind h:Fmt.Tien(TongTra)}" Style="{StaticResource TableCellStyle}" FontWeight="Bold" Foreground="{ThemeResource BrandBrush}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind h:Fmt.Tien(DuNoConLai)}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 3. Danh sách hợp đồng vay -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Fmt.An(ViewModel.DangLapHoSo), Mode=OneWay}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled">
                    <Grid MinWidth="1150" RowSpacing="12" Visibility="{x:Bind h:Fmt.An(ViewModel.DangXemLich), Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource TableHeaderBorderStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mã hợp đồng" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="Khách hàng" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="Gói vay" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="Số tiền vay" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="Dư nợ gốc" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="Lãi suất" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="6" Text="Trả góp/tháng" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Text="Trạng thái" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="8" Text="Thao tác" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DanhSach, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource TableListViewItemStyle}" />
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:KhoanVay">
                                    <Grid ColumnSpacing="12" Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind MaSoHopDongVay}" Style="{StaticResource TableCellStyle}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind KhachHang.HoTenKhachHang}" Style="{StaticResource TableCellStyle}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind h:Fmt.Ma(GoiVay)}" Style="{StaticResource TableCellStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind h:Fmt.Tien(SoTienVayBanDau)}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind h:Fmt.Tien(DuNoGocHienTai)}" Style="{StaticResource TableCellStyle}" FontWeight="Bold" Foreground="{ThemeResource WarningBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind h:Fmt.PhanTram(LaiSuatVayNam)}" Style="{StaticResource TableCellStyle}" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind h:Fmt.Tien(SoTienPhaiTraHangThang)}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Border Grid.Column="7" Style="{StaticResource BadgeBorderStyle}">
                                            <TextBlock Text="{x:Bind h:Fmt.Ma(TrangThaiKhoanVay)}" Style="{StaticResource BadgeTextStyle}" Foreground="{x:Bind h:Fmt.MauTrangThai(TrangThaiKhoanVay)}" />
                                        </Border>
                                        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <!-- Nút duyệt & từ chối chỉ hiển thị cho Quản trị viên khi hồ sơ đang CHO_PHE_DUYET -->
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        Visibility="{Binding ElementName=ThisPage, Path=ViewModel.HienThiNutPheDuyet}">
                                                <Button Visibility="{x:Bind h:Fmt.HienNeuBang(TrangThaiKhoanVay, 'CHO_PHE_DUYET')}"
                                                        Command="{Binding ElementName=ThisPage, Path=ViewModel.PheDuyetCommand}"
                                                        CommandParameter="{x:Bind}">
                                                    <TextBlock Text="Duyệt" FontSize="11" Foreground="{ThemeResource SuccessBrush}" FontWeight="SemiBold" />
                                                </Button>
                                                <Button Visibility="{x:Bind h:Fmt.HienNeuBang(TrangThaiKhoanVay, 'CHO_PHE_DUYET')}"
                                                        Command="{Binding ElementName=ThisPage, Path=ViewModel.TuChoiCommand}"
                                                        CommandParameter="{x:Bind}">
                                                    <TextBlock Text="Từ chối" FontSize="11" Foreground="{ThemeResource DangerBrush}" />
                                                </Button>
                                            </StackPanel>
                                            <!-- Nút xem lịch trả nợ -->
                                            <Button Command="{Binding ElementName=ThisPage, Path=ViewModel.XemLichTraNoCommand}"
                                                    CommandParameter="{x:Bind}">
                                                <TextBlock Text="Lịch trả" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
