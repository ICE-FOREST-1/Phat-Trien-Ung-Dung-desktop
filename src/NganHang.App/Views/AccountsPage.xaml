<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NganHang.App.Views.AccountsPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:NganHang.Core.Entities"
    xmlns:h="using:NganHang.App.Helpers"
    Background="Transparent">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề + nút mở tài khoản -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Quản lý tài khoản thanh toán" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Danh sách tài khoản thanh toán, quản lý hạn mức thấu chi và khóa/mở khóa" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Top">
                <CheckBox Content="Chỉ hiện tài khoản hoạt động" IsChecked="{x:Bind ViewModel.ChiHienHoatDong, Mode=TwoWay}" Command="{x:Bind ViewModel.TaiDuLieuCommand}" />
                <Button Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.DuocPhepMoTaiKhoan}"
                        Command="{x:Bind ViewModel.BatDauMoTaiKhoanCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Mở tài khoản mới" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.CoThongBao, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.MucDoThongBao, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ThongBao, Mode=OneWay}" />

        <!-- Bảng danh sách hoặc Form mở tài khoản -->
        <Grid Grid.Row="2">
            <!-- 1. Form mở tài khoản mới -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.DangMoTaiKhoan, Mode=OneWay}" MaxWidth="620" HorizontalAlignment="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Mở tài khoản thanh toán mới" Style="{StaticResource SectionTitleStyle}" />
                        
                        <!-- Lựa chọn: Khách hàng mới vs Đã có CIF -->
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <RadioButton Content="Khách hàng mới" IsChecked="{x:Bind ViewModel.LaKhachHangMoi, Mode=TwoWay}" />
                            <RadioButton Content="Khách hàng đã có CIF" IsChecked="{x:Bind ViewModel.LaKhachHangHienHuu, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Khối thông tin khách hàng mới -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.LaKhachHangMoi, Mode=OneWay}">
                            <TextBox Header="Họ và tên khách hàng *" PlaceholderText="vd: Nguyễn Văn An"
                                     Text="{x:Bind ViewModel.FormHoTen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Header="Số CCCD (12 chữ số) *" PlaceholderText="vd: 079201004821" MaxLength="12"
                                         Text="{x:Bind ViewModel.FormCccd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="1" Header="Số điện thoại (10 chữ số) *" PlaceholderText="vd: 0908123456" MaxLength="10"
                                         Text="{x:Bind ViewModel.FormSdt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CalendarDatePicker Grid.Column="0" Header="Ngày sinh *" HorizontalAlignment="Stretch"
                                                    Date="{x:Bind ViewModel.FormNgaySinh, Mode=TwoWay}" />
                                <ComboBox Grid.Column="1" Header="Giới tính *" HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.DanhSachGioiTinh}"
                                          SelectedItem="{x:Bind ViewModel.FormGioiTinh, Mode=TwoWay}" />
                            </Grid>

                            <TextBox Header="Địa chỉ thường trú *" PlaceholderText="vd: 128 Nguyễn Trãi, Quận 1, TP.HCM"
                                     Text="{x:Bind ViewModel.FormDiaChi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Khối chọn khách hàng đã có CIF -->
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.LaKhachHangHienHuu, Mode=OneWay}">
                            <ComboBox Header="Chọn khách hàng hiện hữu (CIF) *" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.DanhSachKhachHang, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.KhachHangChon, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="m:KhachHang">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind HoTenKhachHang}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind MaCIF}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Ô chọn số tài khoản: tự nhập hoặc random -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Số tài khoản thanh toán *" Style="{StaticResource LabelStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="vd: 19034589201999 (hoặc bấm Tạo ngẫu nhiên)"
                                         Text="{x:Bind ViewModel.FormSoTaiKhoan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.TaoSoTaiKhoanNgauNhienCommand}" ToolTipService.ToolTip="Phát sinh số tài khoản ngẫu nhiên">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                        <TextBlock Text="Tạo ngẫu nhiên" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <NumberBox Header="Số tiền nộp ban đầu (VND) *"
                                   Value="{x:Bind ViewModel.SoTienNapBanDau, Mode=TwoWay}"
                                   Minimum="0" SpinButtonPlacementMode="Hidden" />

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                            <Button Content="Xác nhận mở tài khoản" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.XacNhanMoTaiKhoanCommand}" />
                            <Button Content="Hủy bỏ" Command="{x:Bind ViewModel.HuyMoTaiKhoanCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 2. Danh sách tài khoản (có thanh cuộn ngang) -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind h:Fmt.An(ViewModel.DangMoTaiKhoan), Mode=OneWay}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel MinWidth="1100" Spacing="12">
                        <Border Style="{StaticResource TableHeaderBorderStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Số tài khoản" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="Chủ tài khoản" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="Số dư hiện tại" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="Hạn mức thấu chi" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="Hạng tài khoản" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="5" Text="Trạng thái" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="6" Text="Thao tác" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <ListView ItemsSource="{x:Bind ViewModel.DanhSach, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource TableListViewItemStyle}" />
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="m:TaiKhoanThanhToan">
                                    <Grid ColumnSpacing="12" Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind SoTaiKhoan}" Style="{StaticResource TableCellStyle}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind KhachHang.HoTenKhachHang}" Style="{StaticResource TableCellStyle}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind h:Fmt.Tien(SoDuHienTai)}" Style="{StaticResource TableCellStyle}" FontWeight="Bold" Foreground="{ThemeResource BrandBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind h:Fmt.TienN(HanMucThauChi)}" Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Border Grid.Column="4" Style="{StaticResource BadgeBorderStyle}" Background="{x:Bind h:Fmt.MauHang(HangTaiKhoan)}">
                                            <TextBlock Text="{x:Bind h:Fmt.Ma(HangTaiKhoan)}" Foreground="White" Style="{StaticResource BadgeTextStyle}" />
                                        </Border>
                                        <Border Grid.Column="5" Style="{StaticResource BadgeBorderStyle}">
                                            <TextBlock Text="{x:Bind h:Fmt.Ma(TrangThaiTaiKhoan), Mode=OneWay}" Style="{StaticResource BadgeTextStyle}" Foreground="{x:Bind h:Fmt.MauTrangThai(TrangThaiTaiKhoan), Mode=OneWay}" />
                                        </Border>
                                        <Button Grid.Column="6" HorizontalAlignment="Right"
                                                Command="{Binding ElementName=ThisPage, Path=ViewModel.KhoaHoacMoKhoaCommand}"
                                                CommandParameter="{x:Bind}">
                                            <TextBlock Text="Đổi trạng thái" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
