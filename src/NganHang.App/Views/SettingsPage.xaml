<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NganHang.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:NganHang.App.Helpers"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Cài đặt hệ thống" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Tùy biến giao diện Fluent, quản lý tài khoản bảo mật và thông tin cơ sở dữ liệu" Style="{StaticResource PageSubtitleStyle}" />

            <InfoBar IsOpen="{x:Bind ViewModel.CoThongBao, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.MucDoThongBao, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ThongBao, Mode=OneWay}" />

            <!-- Giao diện Theme Sáng / Tối -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Giao diện &amp; Chủ đề" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Lựa chọn chủ đề hiển thị Fluent Design cho ứng dụng (lưu tự động vào máy tính)." Style="{StaticResource LabelStyle}" />

                    <RadioButtons SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MaxColumns="3">
                        <RadioButton Content="Theo hệ thống Windows" />
                        <RadioButton Content="Chế độ Sáng (Light)" />
                        <RadioButton Content="Chế độ Tối (Dark)" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- Thông tin tài khoản người dùng -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Tài khoản đang đăng nhập" Style="{StaticResource SectionTitleStyle}" />

                    <Grid ColumnSpacing="20" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Họ và tên" Style="{StaticResource LabelStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.NguoiDungHienTai.HoTen, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <TextBlock Grid.Row="1" Text="Tên đăng nhập" Style="{StaticResource LabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.NguoiDungHienTai.TenDangNhap, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <TextBlock Grid.Row="2" Text="Vai trò hệ thống" Style="{StaticResource LabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.TenVaiTro, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource BrandBrush}" />

                        <TextBlock Grid.Row="3" Text="Chi nhánh" Style="{StaticResource LabelStyle}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.NguoiDungHienTai.ChiNhanh, Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Đổi mật khẩu -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Đổi mật khẩu tài khoản" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Mật khẩu được mã hóa một chiều bằng thuật toán BCrypt với salt ngẫu nhiên." Style="{StaticResource LabelStyle}" />

                    <PasswordBox Header="Mật khẩu hiện tại *" PlaceholderText="••••••"
                                 Password="{x:Bind ViewModel.MatKhauCu, Mode=TwoWay}" />
                    <PasswordBox Header="Mật khẩu mới (ít nhất 6 ký tự) *" PlaceholderText="••••••"
                                 Password="{x:Bind ViewModel.MatKhauMoi, Mode=TwoWay}" />
                    <PasswordBox Header="Xác nhận mật khẩu mới *" PlaceholderText="••••••"
                                 Password="{x:Bind ViewModel.XacNhanMatKhau, Mode=TwoWay}" />

                    <Button Content="Cập nhật mật khẩu" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Left" Command="{x:Bind ViewModel.DoiMatKhauCommand}" />
                </StackPanel>
            </Border>

            <!-- Cơ sở dữ liệu SQL Server -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Cơ sở dữ liệu SQL Server" Style="{StaticResource SectionTitleStyle}" />
                        <Button HorizontalAlignment="Right" Content="Kiểm tra kết nối" Command="{x:Bind ViewModel.KiemTraKetNoiCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{ThemeResource SuccessBrush}" Visibility="{x:Bind ViewModel.DaKetNoi, Mode=OneWay}" />
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{ThemeResource DangerBrush}" Visibility="{x:Bind h:Fmt.An(ViewModel.DaKetNoi), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.ThongTinKetNoi, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>

                    <TextBlock Text="Phương thức xác thực: Windows Authentication (Integrated Security). Không yêu cầu mật khẩu."
                               Style="{StaticResource LabelStyle}" />
                    <TextBlock Text="Cơ chế: Entity Framework Core 8, DbContext pooling, gọi Stored Procedure ACID và Trigger tự động."
                               Style="{StaticResource LabelStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
