<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NganHang.App.Views.AmlPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:NganHang.Core.Entities"
    xmlns:h="using:NganHang.App.Helpers"
    Background="Transparent">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề + lọc trạng thái -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Phòng chống rửa tiền (AML)" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Cảnh báo tự động kích hoạt bởi trigger cơ sở dữ liệu khi phát hiện giao dịch lớn hoặc bất thường" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <ComboBox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="240"
                      ItemsSource="{x:Bind ViewModel.DanhSachTrangThai}"
                      SelectedItem="{x:Bind ViewModel.TrangThaiChon, Mode=TwoWay}"
                      SelectionChanged="ComboBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Ten}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.CoThongBao, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.MucDoThongBao, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ThongBao, Mode=OneWay}" />

        <!-- Bảng danh sách cảnh báo AML -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource TableHeaderBorderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="Số tài khoản" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="Tên khách hàng" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="Số tiền phát sinh" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Mức độ rủi ro" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="5" Text="Lý do trigger phát hiện" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="6" Text="Trạng thái" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="7" Text="Thao tác kiểm duyệt" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.DanhSach, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource TableListViewItemStyle}" />
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="m:CanhBaoAML">
                            <Grid ColumnSpacing="12" Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind MaCanhBao}" Style="{StaticResource TableCellStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind SoTaiKhoanPhatSinh}" Style="{StaticResource TableCellStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind TenKhachHang}" Style="{StaticResource TableCellStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="{x:Bind h:Fmt.Tien(SoTienPhatSinh)}" Style="{StaticResource TableCellStyle}" FontWeight="Bold" Foreground="{ThemeResource DangerBrush}" HorizontalAlignment="Right" />
                                <Border Grid.Column="4" Style="{StaticResource BadgeBorderStyle}">
                                    <TextBlock Text="{x:Bind h:Fmt.Ma(MucDoRuiRo)}" Style="{StaticResource BadgeTextStyle}" Foreground="{x:Bind h:Fmt.MauTrangThai(MucDoRuiRo)}" />
                                </Border>
                                <TextBlock Grid.Column="5" Text="{x:Bind LyDoTriggerPhatHien}" Style="{StaticResource TableCellStyle}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="6" Style="{StaticResource BadgeBorderStyle}">
                                    <TextBlock Text="{x:Bind h:Fmt.Ma(TrangThaiXuLy)}" Style="{StaticResource BadgeTextStyle}" Foreground="{x:Bind h:Fmt.MauTrangThai(TrangThaiXuLy)}" />
                                </Border>
                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                            Visibility="{x:Bind h:Fmt.HienNeuBang(TrangThaiXuLy, 'CHO_KIEM_DUYET')}">
                                    <Button IsEnabled="{Binding ElementName=ThisPage, Path=ViewModel.DuocPhepXuLy}"
                                            Command="{Binding ElementName=ThisPage, Path=ViewModel.DuyetAnToanCommand}"
                                            CommandParameter="{x:Bind}">
                                        <TextBlock Text="An toàn" FontSize="11" Foreground="{ThemeResource SuccessBrush}" FontWeight="SemiBold" />
                                    </Button>
                                    <Button IsEnabled="{Binding ElementName=ThisPage, Path=ViewModel.DuocPhepXuLy}"
                                            Command="{Binding ElementName=ThisPage, Path=ViewModel.KhoaTaiKhoanCommand}"
                                            CommandParameter="{x:Bind}">
                                        <TextBlock Text="Khóa TK" FontSize="11" Foreground="{ThemeResource DangerBrush}" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
