<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="NganHang.App.Views.LoansPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:NganHang.Core.Policies"
    xmlns:m="using:NganHang.Core.Entities"
    xmlns:h="using:NganHang.App.Helpers"
    Background="Transparent">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Quản lý tín dụng &amp; Cho vay" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Thẩm định hồ sơ, phê duyệt hạn mức và giải ngân trực tiếp vào tài khoản thanh toán" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Button x:ConnectionId='53' Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource AccentButtonStyle}"
                                                                   
                                                                     >
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Lập hồ sơ vay mới" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:ConnectionId='2' Grid.Row="1"
                                                                    
                                                                         
                                                                    />

        <!-- Khung nội dung -->
        <Grid Grid.Row="2">
            <!-- 1. Form lập hồ sơ vay mới -->
            <Border x:ConnectionId='3' Style="{StaticResource CardStyle}"                                                          MaxWidth="620" HorizontalAlignment="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Lập hồ sơ vay vốn tín dụng" Style="{StaticResource SectionTitleStyle}" />

                        <!-- Tài khoản giải ngân -->
                        <ComboBox x:ConnectionId='33' Header="Tài khoản giải ngân *" HorizontalAlignment="Stretch"
                                                                                                
                                                                                                     >
                            <ComboBox.ItemTemplate>
                                <DataTemplate                                 >
                                    <Grid x:ConnectionId='50' ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:ConnectionId='51'                            FontWeight="SemiBold" />
                                        <TextBlock x:ConnectionId='52' Grid.Column="1"                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:ConnectionId='45' Header="Gói vay vốn *" HorizontalAlignment="Stretch"
                                                                                     
                                                                                               >
                                <ComboBox.ItemTemplate>
                                    <DataTemplate                      >
                                        <TextBlock x:ConnectionId='48'                                      />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <NumberBox x:ConnectionId='46' Grid.Column="1" Header="Thời hạn vay (tháng) *"
                                                                                           
                                       Minimum="1" Maximum="360" SpinButtonPlacementMode="Inline" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox x:ConnectionId='43' Header="Số tiền vay (VND) *"
                                                                                        
                                       Minimum="10000000" SpinButtonPlacementMode="Hidden" />
                            <NumberBox x:ConnectionId='44' Grid.Column="1" Header="Lãi suất vay (%/năm)"
                                                                                            
                                       SpinButtonPlacementMode="Hidden" IsEnabled="False" />
                        </Grid>

                        <TextBox x:ConnectionId='34' Header="Mục đích sử dụng vốn *"
                                                                                                                     />

                        <!-- Tài sản thế chấp nếu không phải vay tín chấp -->
                        <ComboBox x:ConnectionId='35' Header="Tài sản đảm bảo (nếu có)" HorizontalAlignment="Stretch"
                                                                                              
                                                                                           >
                            <ComboBox.ItemTemplate>
                                <DataTemplate                            >
                                    <StackPanel x:ConnectionId='40' Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:ConnectionId='41'                           FontWeight="SemiBold" />
                                        <TextBlock x:ConnectionId='42'                                           Foreground="{ThemeResource BrandBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Thẻ tạm tính tiền trả góp -->
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Số tiền trả góp hàng tháng dự kiến (Gốc + Lãi)" Style="{StaticResource LabelStyle}" />
                                <TextBlock x:ConnectionId='38'                                                                          Style="{StaticResource ValueStyle}" Foreground="{ThemeResource BrandBrush}" FontSize="20" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                            <Button x:ConnectionId='36' Content="Xác nhận lập hồ sơ" Style="{StaticResource AccentButtonStyle}"                                                    />
                            <Button x:ConnectionId='37' Content="Hủy bỏ"                                                />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 2. Bảng lịch trả nợ chi tiết -->
            <Border x:ConnectionId='4' Style="{StaticResource CardStyle}"                                                         >
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock x:ConnectionId='31'                                                                    Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:ConnectionId='32'                                                                              Style="{StaticResource LabelStyle}" />
                        </StackPanel>
                        <Button x:ConnectionId='30' HorizontalAlignment="Right" Content="Đóng lịch"                                                   />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource TableHeaderBorderStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Kỳ" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="Ngày trả" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="Tiền gốc" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="Tiền lãi" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="Tổng trả kỳ này" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="Dư nợ còn lại" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <ListView x:ConnectionId='21' Grid.Row="2"                                                         SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource TableListViewItemStyle}" />
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate                       >
                                <Grid x:ConnectionId='23' ColumnSpacing="12" Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:ConnectionId='24' Grid.Column="0"                    Style="{StaticResource TableCellStyle}" FontWeight="SemiBold" />
                                    <TextBlock x:ConnectionId='25' Grid.Column="1"                                     Style="{StaticResource TableCellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:ConnectionId='26' Grid.Column="2"                                     Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" />
                                    <TextBlock x:ConnectionId='27' Grid.Column="3"                                     Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" />
                                    <TextBlock x:ConnectionId='28' Grid.Column="4"                                     Style="{StaticResource TableCellStyle}" FontWeight="Bold" Foreground="{ThemeResource BrandBrush}" HorizontalAlignment="Right" />
                                    <TextBlock x:ConnectionId='29' Grid.Column="5"                                        Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 3. Danh sách hợp đồng vay -->
            <Border x:ConnectionId='5' Style="{StaticResource CardStyle}"                                                                   >
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled">
                    <Grid x:ConnectionId='6' MinWidth="1150" RowSpacing="12"                                                                   >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource TableHeaderBorderStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mã hợp đồng" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="Khách hàng" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="Gói vay" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="Số tiền vay" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="Dư nợ gốc" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="Lãi suất" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="6" Text="Trả góp/tháng" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="7" Text="Trạng thái" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="8" Text="Thao tác" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <ListView x:ConnectionId='7' Grid.Row="1"                                                        SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource TableListViewItemStyle}" />
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate                        >
                                    <Grid x:ConnectionId='9' ColumnSpacing="12" Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:ConnectionId='10' Grid.Column="0"                                Style="{StaticResource TableCellStyle}" FontWeight="SemiBold" />
                                        <TextBlock x:ConnectionId='11' Grid.Column="1"                                          Style="{StaticResource TableCellStyle}" />
                                        <TextBlock x:ConnectionId='12' Grid.Column="2"                                  Style="{StaticResource TableCellStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:ConnectionId='13' Grid.Column="3"                                             Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" />
                                        <TextBlock x:ConnectionId='14' Grid.Column="4"                                            Style="{StaticResource TableCellStyle}" FontWeight="Bold" Foreground="{ThemeResource WarningBrush}" HorizontalAlignment="Right" />
                                        <TextBlock x:ConnectionId='15' Grid.Column="5"                                               Style="{StaticResource TableCellStyle}" />
                                        <TextBlock x:ConnectionId='16' Grid.Column="6"                                                    Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Border Grid.Column="7" Style="{StaticResource BadgeBorderStyle}">
                                            <TextBlock x:ConnectionId='20'                                             Style="{StaticResource BadgeTextStyle}"                                                             />
                                        </Border>
                                        <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <!-- Nút duyệt & từ chối chỉ hiển thị cho Quản trị viên khi hồ sơ đang CHO_PHE_DUYET -->
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        Visibility="{Binding ElementName=ThisPage, Path=ViewModel.HienThiNutPheDuyet}">
                                                <Button x:ConnectionId='18'                                                                            
                                                        Command="{Binding ElementName=ThisPage, Path=ViewModel.PheDuyetCommand}"
                                                                                   >
                                                    <TextBlock Text="Duyệt" FontSize="11" Foreground="{ThemeResource SuccessBrush}" FontWeight="SemiBold" />
                                                </Button>
                                                <Button x:ConnectionId='19'                                                                            
                                                        Command="{Binding ElementName=ThisPage, Path=ViewModel.TuChoiCommand}"
                                                                                   >
                                                    <TextBlock Text="Từ chối" FontSize="11" Foreground="{ThemeResource DangerBrush}" />
                                                </Button>
                                            </StackPanel>
                                            <!-- Nút xem lịch trả nợ -->
                                            <Button x:ConnectionId='17' Command="{Binding ElementName=ThisPage, Path=ViewModel.XemLichTraNoCommand}"
                                                                               >
                                                <TextBlock Text="Lịch trả" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>

