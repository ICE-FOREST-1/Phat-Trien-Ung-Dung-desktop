<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="NganHang.App.Views.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:NganHang.Core.Entities"
    xmlns:h="using:NganHang.App.Helpers"
    Background="Transparent">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Tra cứu khách hàng 360°" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Hồ sơ định danh CIF, tài khoản thanh toán, sổ tiết kiệm và hợp đồng tín dụng" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </Grid>

        <InfoBar x:ConnectionId='2' Grid.Row="1"
                                                                    
                                                                         
                                                                    />

        <!-- Khung nội dung: 2 cột (Danh sách bên trái 380px, Chi tiết 360° bên phải) -->
        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: Tìm kiếm + Danh sách -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Ô tìm kiếm -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Tìm kiếm khách hàng" Style="{StaticResource LabelStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:ConnectionId='60' PlaceholderText="Tìm tên, CIF, CCCD, SĐT…"
                                                                                                                       
                                                                 />
                            <Button x:ConnectionId='61' Grid.Column="1"                                             ToolTipService.ToolTip="Tìm kiếm">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <ListView x:ConnectionId='52' Grid.Row="1"                                                       
                                                                                          
                                                                          >
                        <ListView.ItemTemplate>
                            <DataTemplate                         >
                                <Grid x:ConnectionId='54' ColumnSpacing="12" Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture x:ConnectionId='55' Width="36" Height="36"                                                     />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:ConnectionId='58'                                Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:ConnectionId='59'                       Style="{StaticResource LabelStyle}" />
                                    </StackPanel>
                                    <Border x:ConnectionId='56' Grid.Column="2" Style="{StaticResource BadgeBorderStyle}"                                                 >
                                        <TextBlock x:ConnectionId='57'                                       Foreground="White" Style="{StaticResource BadgeTextStyle}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- CỘT PHẢI: Hồ sơ chi tiết HOẶC Form thêm/sửa -->
            <Grid Grid.Column="1">
                <!-- 1. Form thêm / sửa khách hàng -->
                <Border x:ConnectionId='3' Style="{StaticResource CardStyle}"                                                          >
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" MaxWidth="620" HorizontalAlignment="Left">
                            <TextBlock Text="Thông tin hồ sơ khách hàng" Style="{StaticResource SectionTitleStyle}" />

                            <TextBox x:ConnectionId='40' Header="Họ và tên khách hàng *"
                                                                                                                           />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:ConnectionId='50' Header="Số CCCD (12 chữ số) *"
                                                                                                                              />
                                <TextBox x:ConnectionId='51' Grid.Column="1" Header="Số điện thoại (10 chữ số) *"
                                                                                                                             />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DatePicker x:ConnectionId='47' Header="Ngày sinh *"                                                     />
                                <ComboBox x:ConnectionId='48' Grid.Column="1" Header="Giới tính" HorizontalAlignment="Stretch"
                                                                                           
                                                                                                      />
                                <NumberBox x:ConnectionId='49' Grid.Column="2" Header="Điểm tín dụng (300-850)"
                                                                                                  
                                           Minimum="300" Maximum="850" SpinButtonPlacementMode="Inline" />
                            </Grid>

                            <TextBox x:ConnectionId='41' Header="Email"                                                                                       />

                            <TextBox x:ConnectionId='42' Header="Địa chỉ thường trú *"
                                                                                                                            />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:ConnectionId='45' Header="Nghề nghiệp"                                                                                            />
                                <NumberBox x:ConnectionId='46' Grid.Column="1" Header="Thu nhập hàng tháng (VND)"
                                                                                              
                                           SpinButtonPlacementMode="Hidden" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                                <Button x:ConnectionId='43' Content="Lưu thông tin" Style="{StaticResource AccentButtonStyle}"                                                  />
                                <Button x:ConnectionId='44' Content="Hủy bỏ"                                                 />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 2. Xem chi tiết 360° -->
                <ScrollViewer x:ConnectionId='4' VerticalScrollBarVisibility="Auto"                                                                    >
                    <StackPanel x:ConnectionId='5' Spacing="16"                                                                            >
                        <!-- Thẻ thông tin khách hàng cơ bản -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <PersonPicture x:ConnectionId='34' Width="64" Height="64"                                                                                          />

                                <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="6" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock x:ConnectionId='37'                                                                     Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <Border x:ConnectionId='38' Style="{StaticResource BadgeBorderStyle}"                                                                                      >
                                            <TextBlock x:ConnectionId='39'                                                                            Foreground="White" Style="{StaticResource BadgeTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:ConnectionId='36'                                                            Style="{StaticResource LabelStyle}" />
                                </StackPanel>

                                <Button x:ConnectionId='35' Grid.Column="2" VerticalAlignment="Top"
                                                                                       
                                                                                     >
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                        <TextBlock Text="Chỉnh sửa" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Lưới chi tiết CCCD, SĐT, Địa chỉ, Điểm tín dụng -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="20" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="2">
                                    <TextBlock Text="Số CCCD" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:ConnectionId='33'                                                             Style="{StaticResource ValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Số điện thoại" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:ConnectionId='32'                                                                  Style="{StaticResource ValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Email" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:ConnectionId='31'                                                                       Style="{StaticResource ValueStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="2">
                                    <TextBlock Text="Điểm tín dụng" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:ConnectionId='30'                                                                            Style="{StaticResource ValueStyle}" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Thu nhập hàng tháng" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:ConnectionId='29'                                                                                    Style="{StaticResource ValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Địa chỉ" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:ConnectionId='28'                                                                      Style="{StaticResource ValueStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Danh sách tài khoản thanh toán -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Tài khoản thanh toán" Style="{StaticResource SectionTitleStyle}" />
                                <ListView x:ConnectionId='21'                                                                       SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate                                 >
                                            <Grid x:ConnectionId='23' ColumnSpacing="16" Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:ConnectionId='24' Grid.Column="0"                            FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='25' Grid.Column="1"                                         FontWeight="Bold" Foreground="{ThemeResource BrandBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='26' Grid.Column="2"                                             VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='27' Grid.Column="3"                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Danh sách sổ tiết kiệm -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Sổ tiết kiệm" Style="{StaticResource SectionTitleStyle}" />
                                <ListView x:ConnectionId='13'                                                                         SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate                          >
                                            <Grid x:ConnectionId='15' ColumnSpacing="16" Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="100" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:ConnectionId='16' Grid.Column="0"                        FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='17' Grid.Column="1"                                           FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='18' Grid.Column="2"                                            VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='19' Grid.Column="3"                            VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='20' Grid.Column="4"                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- Danh sách hợp đồng vay -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Hợp đồng tín dụng &amp; Cho vay" Style="{StaticResource SectionTitleStyle}" />
                                <ListView x:ConnectionId='6'                                                                       SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate                        >
                                            <Grid x:ConnectionId='8' ColumnSpacing="16" Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="140" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:ConnectionId='9' Grid.Column="0"                                FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='10' Grid.Column="1"                                            FontWeight="Bold" Foreground="{ThemeResource WarningBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='11' Grid.Column="2"                                  TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock x:ConnectionId='12' Grid.Column="3"                                             HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>

