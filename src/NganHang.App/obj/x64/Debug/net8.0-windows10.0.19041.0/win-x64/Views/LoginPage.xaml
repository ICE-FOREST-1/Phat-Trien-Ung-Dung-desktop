<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="NganHang.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>

        <!-- Panel thương hiệu -->
        <Grid Margin="24,0,12,24" CornerRadius="12">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#9F1239" Offset="0" />
                    <GradientStop Color="#E11D48" Offset="0.55" />
                    <GradientStop Color="#1E293B" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel VerticalAlignment="Center" Margin="56" Spacing="18">
                <Border Width="56" Height="56" CornerRadius="12" Background="#33FFFFFF" HorizontalAlignment="Left">
                    <TextBlock Text="TC" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Core Banking System" FontSize="36" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="Hệ thống quản lý tài khoản ngân hàng dành cho giao dịch viên, chuyên viên tín dụng và bộ phận kiểm soát rủi ro."
                           Foreground="#E2E8F0" FontSize="15" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
                <StackPanel Spacing="10" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE73E;" Foreground="White" FontSize="14" />
                        <TextBlock Text="Giao dịch ACID trên SQL Server, hạch toán Nợ – Có cân đối" Foreground="White" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE73E;" Foreground="White" FontSize="14" />
                        <TextBlock Text="Tự động phát hiện giao dịch đáng ngờ (AML)" Foreground="White" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE73E;" Foreground="White" FontSize="14" />
                        <TextBlock Text="Phân quyền theo vai trò, mật khẩu băm BCrypt" Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Form đăng nhập -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380" Margin="24" Spacing="16">
                <TextBlock Text="Đăng nhập" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Sử dụng tài khoản nhân viên được cấp" Style="{StaticResource PageSubtitleStyle}" Margin="0,-8,0,4" />

                <InfoBar x:ConnectionId='2'                                                    
                                                                                 
                                                                            />

                <TextBox x:ConnectionId='3' Header="Tên đăng nhập" PlaceholderText="vd: teller"
                                                                                                                 />
                <PasswordBox x:ConnectionId='4' x:Name="MatKhauBox" Header="Mật khẩu" PlaceholderText="••••••"
                                                                                                             />

                <Grid>
                    <Button x:ConnectionId='9' Content="Đăng nhập" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="38"
                                                                                                                              />
                    <ProgressRing x:ConnectionId='10'                                                    Width="20" Height="20" HorizontalAlignment="Right" Margin="0,0,12,0" />
                </Grid>

                <MenuFlyoutSeparator Margin="0,4" />
                <TextBlock Text="Đăng nhập nhanh (mật khẩu 123456)" Style="{StaticResource LabelStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button x:ConnectionId='7' HorizontalAlignment="Stretch"                                                   CommandParameter="teller"
                                                                                >
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE77B;" FontSize="14" /><TextBlock Text="Giao dịch viên" /></StackPanel>
                    </Button>
                    <Button x:ConnectionId='8' Grid.Column="1" HorizontalAlignment="Stretch"                                                   CommandParameter="admin"
                                                                                >
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7EF;" FontSize="14" /><TextBlock Text="Quản trị viên" /></StackPanel>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Ellipse x:ConnectionId='5' Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SuccessBrush}"
                                                                                   />
                    <TextBlock x:ConnectionId='6'                                                        Style="{StaticResource LabelStyle}" TextWrapping="Wrap" MaxWidth="360" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

