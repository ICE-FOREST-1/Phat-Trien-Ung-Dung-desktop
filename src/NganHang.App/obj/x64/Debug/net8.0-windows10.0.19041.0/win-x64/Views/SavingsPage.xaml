<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="NganHang.App.Views.SavingsPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:NganHang.Core.Entities"
    xmlns:h="using:NganHang.App.Helpers"
    Background="Transparent">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Quản lý tiết kiệm" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Mở sổ tiết kiệm trực tuyến hoặc nộp tiền mặt tại quầy, tự động tính lãi theo kỳ hạn" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <Button x:ConnectionId='51' Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Style="{StaticResource AccentButtonStyle}"
                                                                
                                                                  >
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Mở sổ tiết kiệm mới" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:ConnectionId='2' Grid.Row="1"
                                                                    
                                                                         
                                                                    />

        <!-- Nội dung: Form mở sổ HOẶC Bảng danh sách -->
        <Grid Grid.Row="2">
            <!-- 1. Form mở sổ mới -->
            <Border x:ConnectionId='3' Style="{StaticResource CardStyle}"                                                       MaxWidth="620" HorizontalAlignment="Left">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Mở sổ tiết kiệm mới" Style="{StaticResource SectionTitleStyle}" />

                        <!-- Nguồn gửi: Trích STK vs Nộp tiền mặt -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Phương thức nộp tiền gửi *" Style="{StaticResource LabelStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <RadioButton x:ConnectionId='49' Content="Trích từ tài khoản thanh toán"                                                           />
                                <RadioButton x:ConnectionId='50' Content="Nộp tiền mặt tại quầy (Không cần STK)"                                                        />
                            </StackPanel>
                        </StackPanel>

                        <!-- Khối A: Trích từ tài khoản thanh toán -->
                        <StackPanel x:ConnectionId='19' Spacing="10"                                                           >
                            <ComboBox x:ConnectionId='43' Header="Tài khoản trích tiền *" HorizontalAlignment="Stretch"
                                                                                                    
                                                                                                      >
                                <ComboBox.ItemTemplate>
                                    <DataTemplate                                 >
                                        <Grid x:ConnectionId='45' ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:ConnectionId='46'                            FontWeight="SemiBold" />
                                            <TextBlock x:ConnectionId='47' Grid.Column="1"                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:ConnectionId='48' Grid.Column="2"                                         FontWeight="Bold" Foreground="{ThemeResource BrandBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Khối B: Nộp tiền mặt tại quầy (Không cần STK) -->
                        <StackPanel x:ConnectionId='20' Spacing="12"                                                        >
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <RadioButton x:ConnectionId='41' Content="Khách hàng đã có CIF"                                                                />
                                <RadioButton x:ConnectionId='42' Content="Khách hàng mới"                                                            />
                            </StackPanel>

                            <!-- Khách hàng hiện hữu -->
                            <ComboBox x:ConnectionId='31' Header="Chọn khách hàng gửi tiền *" HorizontalAlignment="Stretch"
                                                                                                     
                                                                                                     
                                                                                                  >
                                <ComboBox.ItemTemplate>
                                    <DataTemplate                         >
                                        <StackPanel x:ConnectionId='38' Orientation="Horizontal" Spacing="10">
                                            <TextBlock x:ConnectionId='39'                                FontWeight="SemiBold" />
                                            <TextBlock x:ConnectionId='40'                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Khách hàng mới toanh -->
                            <StackPanel x:ConnectionId='32' Spacing="10"                                                            >
                                <TextBox x:ConnectionId='33' Header="Họ và tên người gửi tiền *" PlaceholderText="vd: Trần Văn Bình"
                                                                                                                               />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:ConnectionId='35' Grid.Column="0" Header="Số CCCD (12 chữ số) *" PlaceholderText="vd: 079201009999" MaxLength="12"
                                                                                                                                  />
                                    <TextBox x:ConnectionId='36' Grid.Column="1" Header="Số điện thoại (10 chữ số) *" PlaceholderText="vd: 0912345678" MaxLength="10"
                                                                                                                                 />
                                </Grid>

                                <TextBox x:ConnectionId='34' Header="Địa chỉ thường trú *" PlaceholderText="vd: 45 Lê Lợi, Quận 1, TP.HCM"
                                                                                                                                />
                            </StackPanel>
                        </StackPanel>

                        <!-- Ô mã số sổ tiết kiệm: Tự nhập hoặc random -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Mã số sổ tiết kiệm (Mã định danh sổ) *" Style="{StaticResource LabelStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:ConnectionId='29' Grid.Column="0" PlaceholderText="vd: STK-2026-1001 hoặc nhập mã số sổ..." MaxLength="20"
                                                                                                                                />
                                <Button x:ConnectionId='30' Grid.Column="1" Content="🎲 Tạo ngẫu nhiên"
                                                                                             />
                            </Grid>
                        </StackPanel>

                        <NumberBox x:ConnectionId='21' Header="Số tiền gửi (tối thiểu 1.000.000 VND) *"
                                                                                    
                                   Minimum="1000000" SpinButtonPlacementMode="Hidden" />

                        <!-- Chọn kỳ hạn -->
                        <ComboBox x:ConnectionId='22' Header="Kỳ hạn gửi *" HorizontalAlignment="Stretch"
                                                                                
                                                                                           >
                            <ComboBox.ItemTemplate>
                                <DataTemplate                     >
                                    <TextBlock x:ConnectionId='28'                 />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Thẻ lãi suất & lãi dự kiến -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,12" CornerRadius="8">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Lãi suất áp dụng" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:ConnectionId='26'                                                                      Style="{StaticResource ValueStyle}" Foreground="{ThemeResource BrandBrush}" FontSize="18" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Tiền lãi dự kiến" Style="{StaticResource LabelStyle}" />
                                    <TextBlock x:ConnectionId='25'                                                                  Style="{StaticResource ValueStyle}" Foreground="{ThemeResource SuccessBrush}" FontSize="18" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                            <Button x:ConnectionId='23' Content="Xác nhận mở sổ" Style="{StaticResource AccentButtonStyle}"                                                 />
                            <Button x:ConnectionId='24' Content="Hủy bỏ"                                             />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 2. Danh sách sổ tiết kiệm (có thanh cuộn ngang) -->
            <Border x:ConnectionId='4' Style="{StaticResource CardStyle}"                                                                >
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel MinWidth="1200" Spacing="12">
                        <Border Style="{StaticResource TableHeaderBorderStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mã số sổ" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="1" Text="Khách hàng" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="2" Text="Nguồn tiền" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="3" Text="Số tiền gửi" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="Kỳ hạn" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="5" Text="Lãi suất" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="6" Text="Ngày gửi" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="7" Text="Ngày đáo hạn" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="8" Text="Trạng thái" Style="{StaticResource TableHeaderStyle}" />
                                <TextBlock Grid.Column="9" Text="Thao tác" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <ListView x:ConnectionId='5'                                                        SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource TableListViewItemStyle}" />
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate                          >
                                    <Grid x:ConnectionId='7' ColumnSpacing="12" Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:ConnectionId='8' Grid.Column="0"                        Style="{StaticResource TableCellStyle}" FontWeight="SemiBold" />
                                        <TextBlock x:ConnectionId='9' Grid.Column="1"                                          Style="{StaticResource TableCellStyle}" />
                                        <!-- Cột nguồn tiền: STK hoặc Tiền mặt -->
                                        <TextBlock x:ConnectionId='10' Grid.Column="2"                                          Style="{StaticResource TableCellStyle}"                                                                 />
                                        <Border x:ConnectionId='11' Grid.Column="2" Style="{StaticResource BadgeBorderStyle}"                                                               Background="{ThemeResource LayerFillColorDefaultBrush}" HorizontalAlignment="Left">
                                            <TextBlock Text="Tiền mặt tại quầy" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>

                                        <TextBlock x:ConnectionId='12' Grid.Column="3"                                           Style="{StaticResource TableCellStyle}" FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}" HorizontalAlignment="Right" />
                                        <TextBlock x:ConnectionId='13' Grid.Column="4"                            Style="{StaticResource TableCellStyle}" />
                                        <TextBlock x:ConnectionId='14' Grid.Column="5"                                            Style="{StaticResource TableCellStyle}" />
                                        <TextBlock x:ConnectionId='15' Grid.Column="6"                                     Style="{StaticResource TableCellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:ConnectionId='16' Grid.Column="7"                                        Style="{StaticResource TableCellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Border Grid.Column="8" Style="{StaticResource BadgeBorderStyle}">
                                            <TextBlock x:ConnectionId='18'                                       Style="{StaticResource BadgeTextStyle}"                                                       />
                                        </Border>
                                        <Button x:ConnectionId='17' Grid.Column="9" HorizontalAlignment="Right"
                                                                                                                      
                                                Command="{Binding ElementName=ThisPage, Path=ViewModel.TatToanCommand}"
                                                                           >
                                            <TextBlock Text="Tất toán" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>

