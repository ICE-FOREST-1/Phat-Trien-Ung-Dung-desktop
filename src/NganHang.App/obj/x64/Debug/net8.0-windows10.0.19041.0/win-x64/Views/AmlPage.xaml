<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="NganHang.App.Views.AmlPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:NganHang.Core.Entities"
    xmlns:h="using:NganHang.App.Helpers"
    Background="Transparent">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề + lọc trạng thái -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Phòng chống rửa tiền (AML)" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Cảnh báo tự động kích hoạt bởi trigger cơ sở dữ liệu khi phát hiện giao dịch lớn hoặc bất thường" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <ComboBox x:ConnectionId='16' Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="240"
                                                                        
                                                                                  
                                                                  >
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Ten}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <InfoBar x:ConnectionId='2' Grid.Row="1"
                                                                    
                                                                         
                                                                    />

        <!-- Bảng danh sách cảnh báo AML -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource TableHeaderBorderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="1" Text="Số tài khoản" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="2" Text="Tên khách hàng" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="3" Text="Số tiền phát sinh" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Mức độ rủi ro" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="5" Text="Lý do trigger phát hiện" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="6" Text="Trạng thái" Style="{StaticResource TableHeaderStyle}" />
                        <TextBlock Grid.Column="7" Text="Thao tác kiểm duyệt" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <ListView x:ConnectionId='3' Grid.Row="1"                                                        SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource TableListViewItemStyle}" />
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='5' ColumnSpacing="12" Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='6' Grid.Column="0"                           Style="{StaticResource TableCellStyle}" FontWeight="SemiBold" />
                                <TextBlock x:ConnectionId='7' Grid.Column="1"                                    Style="{StaticResource TableCellStyle}" />
                                <TextBlock x:ConnectionId='8' Grid.Column="2"                              Style="{StaticResource TableCellStyle}" FontWeight="SemiBold" />
                                <TextBlock x:ConnectionId='9' Grid.Column="3"                                            Style="{StaticResource TableCellStyle}" FontWeight="Bold" Foreground="{ThemeResource DangerBrush}" HorizontalAlignment="Right" />
                                <Border Grid.Column="4" Style="{StaticResource BadgeBorderStyle}">
                                    <TextBlock x:ConnectionId='15'                                      Style="{StaticResource BadgeTextStyle}"                                                      />
                                </Border>
                                <TextBlock x:ConnectionId='10' Grid.Column="5"                                     Style="{StaticResource TableCellStyle}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="6" Style="{StaticResource BadgeBorderStyle}">
                                    <TextBlock x:ConnectionId='14'                                         Style="{StaticResource BadgeTextStyle}"                                                         />
                                </Border>
                                <StackPanel x:ConnectionId='11' Grid.Column="7" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                                                                                                    >
                                    <Button x:ConnectionId='12' IsEnabled="{Binding ElementName=ThisPage, Path=ViewModel.DuocPhepXuLy}"
                                            Command="{Binding ElementName=ThisPage, Path=ViewModel.DuyetAnToanCommand}"
                                                                       >
                                        <TextBlock Text="An toàn" FontSize="11" Foreground="{ThemeResource SuccessBrush}" FontWeight="SemiBold" />
                                    </Button>
                                    <Button x:ConnectionId='13' IsEnabled="{Binding ElementName=ThisPage, Path=ViewModel.DuocPhepXuLy}"
                                            Command="{Binding ElementName=ThisPage, Path=ViewModel.KhoaTaiKhoanCommand}"
                                                                       >
                                        <TextBlock Text="Khóa TK" FontSize="11" Foreground="{ThemeResource DangerBrush}" FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>

