<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="NganHang.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:NganHang.App.Helpers"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView x:ConnectionId='2' x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="272"
                        IsPaneToggleButtonVisible="True"
                                                                   >

            <NavigationView.MenuItems>
                <NavigationViewItem x:ConnectionId='7' Content="Tổng quan" Tag="TongQuan"                                            >
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:ConnectionId='8' Content="Khách hàng 360°" Tag="KhachHang"                                             >
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE716;" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader x:ConnectionId='9' Content="Nghiệp vụ"                                                 />
                <NavigationViewItem x:ConnectionId='10' Content="Tài khoản thanh toán" Tag="TaiKhoan"                                            >
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:ConnectionId='11' Content="Chuyển khoản" Tag="ChuyenKhoan"                                               >
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:ConnectionId='12' Content="Tiết kiệm" Tag="TietKiem"                                            >
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE825;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:ConnectionId='13' Content="Tín dụng &amp; Cho vay" Tag="TinDung"                                           >
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8EF;" /></NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="Giám sát &amp; Chính sách" />
                <NavigationViewItem x:ConnectionId='14' Content="Nhật ký giao dịch" Tag="NhatKy"                                          >
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:ConnectionId='15' Content="Phòng chống rửa tiền" Tag="Aml"                                       >
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEA18;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:ConnectionId='16' Content="Hạng hội viên" Tag="HangHoiVien"                                               >
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Cài đặt" Tag="CaiDat">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <Grid Margin="12,8,12,12" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture x:ConnectionId='17' Width="36" Height="36"                                                      />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:ConnectionId='19'                                 Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:ConnectionId='20'                                  Style="{StaticResource LabelStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:ConnectionId='18' Grid.Column="2"                                              ToolTipService.ToolTip="Đăng xuất"
                            Background="Transparent" BorderThickness="0" Padding="8">
                        <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                    </Button>
                </Grid>
            </NavigationView.PaneFooter>

            <Frame x:ConnectionId='21' x:Name="ContentFrame" Padding="{StaticResource PagePadding}" />
        </NavigationView>

        <!-- Thanh trạng thái -->
        <Border Grid.Row="1" Padding="16,6" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:ConnectionId='4' Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SuccessBrush}"                                                       />
                    <Ellipse x:ConnectionId='5' Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource DangerBrush}"                                                                 />
                    <TextBlock x:ConnectionId='6'                                                        Style="{StaticResource LabelStyle}" />
                </StackPanel>
                <TextBlock x:ConnectionId='3'                                    Style="{StaticResource LabelStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>

