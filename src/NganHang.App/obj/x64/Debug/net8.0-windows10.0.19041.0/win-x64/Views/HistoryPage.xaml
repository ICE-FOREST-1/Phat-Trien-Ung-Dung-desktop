<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="NganHang.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:NganHang.Core.Entities"
    xmlns:h="using:NganHang.App.Helpers"
    Background="Transparent">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Nhật ký &amp; Bút toán kế toán" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Toàn bộ lịch sử giao dịch bất biến được lưu trữ trên SQL Server theo chuẩn kiểm toán ngân hàng" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!-- Thanh bộ lọc -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox x:ConnectionId='16' Header="Tìm kiếm" PlaceholderText="Mã chứng từ, tài khoản, tên…"
                                                                                                            />

                <ComboBox x:ConnectionId='17' Grid.Column="1" Header="Loại giao dịch" HorizontalAlignment="Stretch"
                                                                       
                                                                                 >
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Ten}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <CalendarDatePicker x:ConnectionId='18' Grid.Column="2" Header="Từ ngày"                                               HorizontalAlignment="Stretch" />
                <CalendarDatePicker x:ConnectionId='19' Grid.Column="3" Header="Đến ngày"                                                HorizontalAlignment="Stretch" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <Button x:ConnectionId='20' Style="{StaticResource AccentButtonStyle}"                                            >
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                            <TextBlock Text="Tìm kiếm" />
                        </StackPanel>
                    </Button>
                    <Button x:ConnectionId='21' Content="Đặt lại"                                                 />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bảng danh sách bút toán (có thanh cuộn ngang con lăn) -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                <StackPanel MinWidth="1420" Spacing="12">
                    <Border Style="{StaticResource TableHeaderBorderStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mã chứng từ" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="1" Text="Người gửi" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="2" Text="Người nhận" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="3" Text="Loại GD" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="4" Text="Số tiền" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="Phí" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="Số dư trước" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="7" Text="Số dư sau" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="8" Text="Nội dung" Style="{StaticResource TableHeaderStyle}" />
                            <TextBlock Grid.Column="9" Text="Thời gian" Style="{StaticResource TableHeaderStyle}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <ListView x:ConnectionId='2'                                                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource TableListViewItemStyle}" />
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate                        >
                                <Grid x:ConnectionId='4' ColumnSpacing="12" Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock x:ConnectionId='14'                           Style="{StaticResource TableCellStyle}" FontWeight="SemiBold" />
                                        <Border x:ConnectionId='15'                                         Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource DangerBrush}">
                                            <TextBlock Text="AML" Foreground="White" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:ConnectionId='5' Grid.Column="1"                             Style="{StaticResource TableCellStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:ConnectionId='6' Grid.Column="2"                              Style="{StaticResource TableCellStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:ConnectionId='7' Grid.Column="3"                                        Style="{StaticResource TableCellStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:ConnectionId='8' Grid.Column="4"                                            Style="{StaticResource TableCellStyle}" FontWeight="Bold" Foreground="{ThemeResource BrandBrush}" HorizontalAlignment="Right" />
                                    <TextBlock x:ConnectionId='9' Grid.Column="5"                                          Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:ConnectionId='10' Grid.Column="6"                                         Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:ConnectionId='11' Grid.Column="7"                                       Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" />
                                    <TextBlock x:ConnectionId='12' Grid.Column="8"                                    Style="{StaticResource TableCellStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:ConnectionId='13' Grid.Column="9"                                                 Style="{StaticResource TableCellStyle}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>

